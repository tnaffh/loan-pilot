# LoanPilot production environment — The-Moon (alphanumeric.cloud).
#
# The real file lives in GCP Secret Manager as `loanpilot-production-env` and is written
# to the server by CI. Never edit the server copy directly; edit the secret. On disk it
# must be root-owned, chmod 600, and OUTSIDE any Plesk vhost docroot — it holds the
# database password, the JWT secret, the Spaces keys and the Resend key.
#
#   gcloud secrets versions access latest --secret=loanpilot-production-env > .env.production
#   # edit, then
#   gcloud secrets versions add loanpilot-production-env --data-file=.env.production

# --- Image selection ---------------------------------------------------------
# Always an immutable git SHA, never `latest` — this is the rollback lever: change the
# tag, `docker compose up -d`, done in ~20 seconds.
IMAGE_REPO=ghcr.io/tnaffh/loan-pilot
IMAGE_TAG=CHANGE_ME_git_sha

# --- Database ----------------------------------------------------------------
# The host's own PostgreSQL 16, reached over its Unix socket (see the volume mount in
# docker-compose.yml). Postgres opens no network listener, so this database is
# unreachable from any other container on the box.
# connection_limit caps our share of a max_connections pool shared with sendhub and
# city_pilot; Prisma would otherwise default to num_cpus*2+1 = 17 on this 8-vCPU host.
DATABASE_URL=postgresql://loanpilot:CHANGE_ME_strong_db_password@localhost/loanpilot?host=/var/run/postgresql&schema=public&connection_limit=10&pool_timeout=20&connect_timeout=10

# --- API ---------------------------------------------------------------------
# REQUIRED. Carry the EXISTING value over from Secret Manager (`loanpilot-jwt-secret`) —
# minting a new one invalidates every staff session (7-day tokens) at cutover.
JWT_SECRET=CHANGE_ME_long_random_secret
# Browser origins allowed by CORS (web + dashboard). Not a security boundary against
# non-browser clients — that is what the loopback port bind is for.
CORS_ORIGINS=https://raccoonsfinance.com,https://www.raccoonsfinance.com,https://pilot.raccoonsfinance.com
# Slug of the tenant the public apply site submits to.
DEFAULT_TENANT_SLUG=rfs
# Public origin of the API itself. Also the default base for OAUTH_CALLBACK_URL.
PUBLIC_API_ORIGIN=https://api.raccoonsfinance.com
# Where invite links, password-reset links and the post-Google-login redirect point.
# Omitting this silently defaults to http://localhost:3001 and breaks all three.
DASHBOARD_URL=https://pilot.raccoonsfinance.com

# --- Document storage (DigitalOcean Spaces) ----------------------------------
STORAGE_DRIVER=s3
S3_BUCKET=raccoonsfinance-loanpilot
# Must be the real Spaces region — SigV4 puts it in the credential scope. Not `auto`.
S3_REGION=sfo3
S3_ENDPOINT=https://sfo3.digitaloceanspaces.com
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Spaces and AWS use virtual-host addressing; only R2/MinIO need path-style. Setting this
# to true against Spaces breaks presigned URLs: the endpoint redirects between styles and
# drops the signed query string, so documents fail to open with nothing logged.
S3_FORCE_PATH_STYLE=false
# LEAVE BLANK. Setting it makes accessUrl() hand out permanent, unsigned, public links to
# every borrower ID copy, payslip and bank statement. Blank = 10-minute presigned URLs.
S3_PUBLIC_URL=
# Unused with the s3 driver (the directory is only created for STORAGE_DRIVER=local),
# but kept identical to the previous Cloud Run config so nothing shifts under us.
UPLOAD_DIR=/tmp/uploads

# --- Email (Resend) ----------------------------------------------------------
# If RESEND_API_KEY is absent the API LOGS emails instead of sending them, and never
# errors — invites and password resets vanish silently. Verify by actually sending one.
RESEND_API_KEY=CHANGE_ME
# Must be on the Resend-verified sending subdomain.
MAIL_FROM=LoanPilot <no-reply@send.raccoonsfinance.com>

# --- Google sign-in (optional; password login works without it) --------------
# Empty GOOGLE_CLIENT_ID disables Google login entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated domain lock on top of the invite-only rule. Empty = no domain lock.
OAUTH_ALLOWED_DOMAINS=
# Defaults to ${PUBLIC_API_ORIGIN}/api/auth/google/callback — which is the URI already
# registered on the OAuth client, so leave it unset unless the API host changes.
# OAUTH_CALLBACK_URL=

# --- Host port bindings (loopback only; nginx fronts them) -------------------
API_PORT=4000
WEB_PORT=3000
DASHBOARD_PORT=3001
